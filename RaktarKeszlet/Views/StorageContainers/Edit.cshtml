@model RaktarKeszlet.Models.StorageContainer

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Rejtett mezők az azonosítók megőrzéséhez -->
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CompanyId" />

    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label fw-bold">Tárolóeszköz neve *</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Type" class="control-label fw-bold">Tárolóeszköz típusa</label>
        <select asp-for="Type" id="selType" class="form-select" asp-items="ViewBag.Types" onchange="toggleNewType()">
            <option value="">-- Válassz típust --</option>
            <option value="NEW_TYPE" class="text-success fw-bold">➕ Új típus megadása...</option>
        </select>

        <!-- Ez az mező jelenik meg, ha az "Új típus megadása..." opciót választja -->
        <input type="text" name="CustomType" id="CustomType" class="form-control mt-2 d-none border-success" placeholder="Írd be az új típust (pl. hordó)..." />
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ShelfId" class="control-label">Polc / Sor</label>
        <select asp-for="ShelfId" class="form-select" asp-items="ViewBag.ShelfId">
            <option value="">-- Szabadon álló (nincs polchoz rendelve) --</option>
        </select>
    </div>

    <div class="form-group mt-4">
        <input type="submit" value="Mentés" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Mégse</a>
    </div>
   

    <script>
        function toggleNewType() {
            var select = document.getElementById("selType");
            var customInput = document.getElementById("CustomType");
            if (select.value === "NEW_TYPE") {
                customInput.classList.remove("d-none");
            } else {
                customInput.classList.add("d-none");
                customInput.value = "";
            }
        }
    </script>
</form>