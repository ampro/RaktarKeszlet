@model RaktarKeszlet.ViewModels.MoveContainerViewModel
@{
    ViewData["Title"] = "Tárolóeszköz Átmozgatása";
}

<h2 class="text-primary"><i class="bi bi-box-seam"></i> Doboz / Raklap átmozgatása</h2>
<p class="text-muted">Mozgass át egy teljes tárolóeszközt. A benne lévő összes termék automatikusan követni fogja!</p>
<hr />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form asp-action="Move" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- 1. TÁROLÓESZKÖZ KIVÁLASZTÁSA -->
    <div class="form-group mb-4">
        <label asp-for="SelectedContainerId" class="control-label fw-bold text-dark mb-1">Mozgatni kívánt tárolóeszköz *</label>
        <select asp-for="SelectedContainerId" class="form-select border-primary" required>
            <option value="">-- Válassz ki egy dobozt / raklapot... --</option>
            @foreach (var c in ViewBag.Containers)
            {
                <option value="@c.Id">@c.Name (@c.Type)</option>
            }
        </select>
        <span asp-validation-for="SelectedContainerId" class="text-danger"></span>
    </div>

    <hr class="text-muted" />
    <h5 class="text-secondary fw-bold mb-3"><i class="bi bi-geo-alt"></i> Célállomás koordinátái</h5>

    <!-- 2. CÉL CÉG / TELEPHELY (ViewModel érték alapján automatikusan kiválasztva) -->
    <div class="form-group mb-3">
        <label asp-for="TargetCompanyId" class="control-label fw-bold small text-muted">1. Cég / Telephely *</label>
        <select asp-for="TargetCompanyId" id="selCompany" class="form-select" required onchange="filterBuildings(false)">
            <option value="">-- Válassz céltelephelyet... --</option>
            @foreach (var comp in ViewBag.Companies)
            {
                <option value="@comp.Id">@comp.Name</option>
            }
        </select>
        <span asp-validation-for="TargetCompanyId" class="text-danger"></span>
    </div>

    <!-- 3. CÉL ÉPÜLET -->
    <div class="form-group mb-3">
        <label asp-for="TargetBuildingId" class="control-label fw-bold small text-muted">2. Raktárépület (Opcionális)</label>
        <select asp-for="TargetBuildingId" id="selBuilding" class="form-select" onchange="filterRooms(false)">
            <option value="">-- Szabadon álló a telephelyen --</option>
            @foreach (var b in ViewBag.Buildings)
            {
                <option value="@b.Id" data-company="@b.CompanyId">@b.Name</option>
            }
        </select>
    </div>

    <!-- 4. CÉL HELYISÉG -->
    <div class="form-group mb-3">
        <label asp-for="TargetRoomId" class="control-label fw-bold small text-muted">3. Raktárhelyiség / Terem (Opcionális)</label>
        <select asp-for="TargetRoomId" id="selRoom" class="form-select" onchange="filterShelves(false)">
            <option value="">-- Szabadon álló az épületben --</option>
            @foreach (var r in ViewBag.Rooms)
            {
                <option value="@r.Id" data-building="@r.BuildingId">@r.Name</option>
            }
        </select>
    </div>

    <!-- 5. CÉL POLC -->
    <div class="form-group mb-4">
        <label asp-for="TargetShelfId" class="control-label fw-bold small text-muted">4. Polc / Sor azonosító (Opcionális)</label>
        <select asp-for="TargetShelfId" id="selShelf" class="form-select">
            <option value="">-- Szabadon álló a teremben --</option>
            @foreach (var s in ViewBag.Shelves)
            {
                <option value="@s.Id" data-room="@s.RoomId">@s.Identifier</option>
            }
        </select>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> Mégse
        </a>
        <button type="submit" class="btn btn-dark px-4 shadow-sm">
            <i class="bi bi-arrow-left-right"></i> Tároló és termékek átmozgatása
        </button>
    </div>
</form>

<!-- OKOS LÉPCSŐZETES JAVASCRIPT SZŰRÉS -->
<script>
    function filterBuildings(isInitial) {
        var compId = document.getElementById("selCompany").value;
        var buildingSelect = document.getElementById("selBuilding");
        var options = buildingSelect.options;

        // Csak akkor ürítjük ki a kijelölést, ha nem az első (szerveroldali) betöltés fut
        if (!isInitial) {
            buildingSelect.value = "";
        }

        for (var i = 1; i < options.length; i++) {
            var opt = options[i];
            if (opt.getAttribute("data-company") === compId || compId === "") {
                opt.style.display = "block";
            } else {
                opt.style.display = "none";
            }
        }
        filterRooms(isInitial);
    }

    function filterRooms(isInitial) {
        var buildId = document.getElementById("selBuilding").value;
        var roomSelect = document.getElementById("selRoom");
        var options = roomSelect.options;

        if (!isInitial) {
            roomSelect.value = "";
        }

        for (var i = 1; i < options.length; i++) {
            var opt = options[i];
            if (opt.getAttribute("data-building") === buildId || buildId === "") {
                opt.style.display = "block";
            } else {
                opt.style.display = "none";
            }
        }
        filterShelves(isInitial);
    }

    function filterShelves(isInitial) {
        var roomId = document.getElementById("selRoom").value;
        var shelfSelect = document.getElementById("selShelf");
        var options = shelfSelect.options;

        if (!isInitial) {
            shelfSelect.value = "";
        }

        for (var i = 1; i < options.length; i++) {
            var opt = options[i];
            if (opt.getAttribute("data-room") === roomId || roomId === "") {
                opt.style.display = "block";
            } else {
                opt.style.display = "none";
            }
        }
    }

    // Amikor az oldal betöltődik, TRUE paraméterrel indítjuk, hogy megmaradjanak a behozott adatok!
    window.onload = function() {
        filterBuildings(true);
    };
</script>
