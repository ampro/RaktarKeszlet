@model IEnumerable<RaktarKeszlet.Models.Shelf>

@{
    ViewData["Title"] = "Polcok és Sorok";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-grid-3x3 text-success"></i> Polcok / Sorok</h1>
        <p class="text-muted mb-0">Itt láthatod a helyiségeken belüli polcokat és tárolósorokat.</p>
    </div>
    <a asp-action="Create" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle"></i> Új polc felvitele
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm rounded text-center py-4">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        Még nem rögzítettél egyetlen polcot sem.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
                        <h5 class="card-title mb-0 fw-bold">
                            <i class="bi bi-layers me-2"></i>@item.Identifier
                        </h5>
                        <span class="badge bg-light text-success fw-bold">Polc / Sor</span>
                    </div>

                    <div class="card-body">
                        <!-- HIERARCHIA HELYSZÍN ADATOK -->
                        <div class="mb-2 text-muted small">
                            <i class="bi bi-door-open"></i> <strong>Helyiség:</strong>
                            @(item.Room?.Name ?? "Nincs helyiséghez rendelve")
                        </div>
                        <div class="mb-2 text-muted small">
                            <i class="bi bi-building"></i> <strong>Épület:</strong>
                            @(item.Room?.Building?.Name ?? "Nincs épülethez rendelve")
                        </div>
                        <div class="mb-3 text-muted small">
                            <i class="bi bi-briefcase"></i> <strong>Cég / Telephely:</strong>
                            @(item.Room?.Building?.Company?.Name ?? "Nincs céghez rendelve")
                        </div>

                        <!-- LEFÚRÓS INFORMÁCIÓ -->
                        <p class="card-text text-secondary small">
                            Kattints a belépésre a polcon elhelyezett tárolóeszközök (dobozok, raklapok) megtekintéséhez.
                        </p>
                    </div>

                    <div class="card-footer bg-light border-top-0 d-flex justify-content-between align-items-center gap-1 py-3">
                        <!-- LEFÚRÓS GOMB (Kártyás belépés) -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Belépés a polcra">
                            <i class="bi bi-arrow-right-circle"></i> Belépés
                        </a>

                        <div class="btn-group">
                            <!-- ÚJ TERMÉK GOMB (Elõre kitöltött adatokkal) -->
                            <a asp-controller="Products"
                               asp-action="Create"
                               asp-route-companyId="@item.Room?.Building?.CompanyId"
                               asp-route-buildingId="@item.Room?.BuildingId"
                               asp-route-roomId="@item.RoomId"
                               asp-route-shelfId="@item.Id"
                               class="btn btn-sm btn-success"
                               title="Termék hozzáadása erre a polcra">
                                <i class="bi bi-plus-circle"></i> + Termék
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Szerkesztés">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Törlés">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}