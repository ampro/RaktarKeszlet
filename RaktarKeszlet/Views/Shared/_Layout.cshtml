<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaktárKészlet</title>

    <!-- Alap Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ÚJ: Bootstrap Ikonok a modern kinézethez -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaktarKeszlet.styles.css" asp-append-version="true" />

    <!-- Google tag (gtag.js) - Amit korábban beállítottunk! -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-54NBDDFVDT"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-54NBDDFVDT');
    </script>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6888682950584370"
            crossorigin="anonymous"></script>

</head>
<body class="bg-light">
    <!-- Egy finom világos háttérszín a teljes oldalnak -->
    <header>
        <!-- ÚJ: Sötét, elegáns navigációs sáv árnyékkal és kicsit nagyobb belső margóval -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3 mb-4">
            <div class="container-fluid px-4">

                <!-- Logó rész -->
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam text-warning fs-4"></i> RaktárKészlet
                </a>

                <!-- Mobil menü gomb -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Menüpontok ikonokkal és kicsit nagyobb (gap-2) térközzel -->
                    <ul class="navbar-nav flex-grow-1 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Főoldal
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Companies" asp-action="Index">
                                <i class="bi bi-buildings me-1"></i> Telephelyek
                            </a>
                        </li>
                       @*  <li class="nav-item">
                            <a class="nav-link" asp-controller="Buildings" asp-action="Index">
                                <i class="bi bi-building me-1"></i> Épületek
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rooms" asp-action="Index">
                                <i class="bi bi-door-open me-1"></i> Helyiségek
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Shelves" asp-action="Index">
                                <i class="bi bi-bookshelf me-1"></i> Polcok
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="StorageContainers" asp-action="Index">
                                <i class="bi bi-box2 me-1"></i> Tárolók
                            </a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-boxes me-1"></i> Termékek
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags me-1"></i> Kategóriák
                            </a>
                        </li>
                    </ul>

                    <!-- Bejelentkezés rész a jobb oldalon -->
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <!-- A fő tartalom egy pici fehér doboz-árnyékos kártyahatást is kaphatna később, de a konténer marad -->
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- ÚJ: Letisztultabb, modern lábléc -->
    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - <i class="bi bi-box-seam"></i> RaktárKészlet Rendszer - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Adatvédelem</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>