@model IEnumerable<RaktarKeszlet.Models.Building>

@{
    ViewData["Title"] = "Épületek listája";
}

<!-- Fejléc és Új gomb -->
<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="fw-bold"><i class="bi bi-building me-2"></i>Épületek</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Új épület felvitele
    </a>
</div>

<!-- Kártyás elrendezésû lista -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <!-- A teljes kártya kattintható és a Részletek (Details) oldalra visz -->
            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">

                <div class="card h-100 shadow-sm border border-light-subtle product-card bg-white text-center">

                    <!-- Ikonos fejléc -->
                    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-2">
                        <i class="bi bi-building text-info" style="font-size: 3.5rem;"></i>
                    </div>

                    <div class="card-body d-flex flex-column pb-4">

                        <!-- ÚJ RÉSZ: A szülõ Telephely (Company) egyértelmû vizuális megjelenítése -->
                        <div class="mb-2">
                            <span class="badge bg-secondary shadow-sm" style="font-size: 0.8rem;">
                                <i class="bi bi-buildings me-1"></i> @item.Company.Name
                            </span>
                        </div>

                        <!-- Épület neve -->
                        <h5 class="card-title fw-bold mb-3">@item.Name</h5>

                        <div class="mt-auto">
                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">Épület</span>
                        </div>
                    </div>

                    <!-- Gyorsgombok a kártya alján -->
                    <div class="card-footer bg-light border-top-0 d-flex justify-content-between p-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-50 me-1">
                            <i class="bi bi-pencil"></i> Szerkesztés
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-50 ms-1">
                            <i class="bi bi-trash"></i> Törlés
                        </a>
                    </div>
                </div>
            </a>
        </div>
    }
</div>