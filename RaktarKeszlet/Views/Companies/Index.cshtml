@model IEnumerable<RaktarKeszlet.Models.Company>

@{
    ViewData["Title"] = "Cégek és Telephelyek";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-briefcase text-dark"></i> Cégek és Telephelyek</h1>
        <p class="text-muted mb-0">A fiókodhoz tartozó saját cégek és telephelyek kezelése.</p>
    </div>
    <a asp-action="Create" class="btn btn-dark shadow-sm">
        <i class="bi bi-plus-circle"></i> Új cég felvitele
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm rounded text-center py-4">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        Még nem rögzítettél egyetlen céget sem.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                        <h5 class="card-title mb-0 fw-bold">
                            <i class="bi bi-briefcase me-2"></i>@item.Name
                        </h5>
                        <span class="badge bg-secondary fw-bold">Cég / Telephely</span>
                    </div>

                    <div class="card-body">
                        <p class="card-text text-secondary small">
                            Ez a tárolási hierarchia legfelsõ szintje. Kattints a belépésre a céghez tartozó épületek kezeléséhez.
                        </p>
                    </div>

                    <div class="card-footer bg-light border-top-0 d-flex justify-content-between align-items-center gap-1 py-3">
                        <!-- LEFÚRÓS GOMB (Kártyás belépés a cégbe) -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="Belépés a cégbe">
                            <i class="bi bi-arrow-right-circle"></i> Belépés
                        </a>

                        <div class="btn-group">
                            <!-- ÚJ TERMÉK GOMB (Cég elõre beállítva) -->
                            <a asp-controller="Products"
                               asp-action="Create"
                               asp-route-companyId="@item.Id"
                               class="btn btn-sm btn-success"
                               title="Termék hozzáadása ehhez a céghez">
                                <i class="bi bi-plus-circle"></i> + Termék
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Szerkesztés">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Törlés">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
