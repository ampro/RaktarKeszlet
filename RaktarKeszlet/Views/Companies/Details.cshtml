@model RaktarKeszlet.ViewModels.CompanyDetailsViewModel

@{
    ViewData["Title"] = "Telephely részletei";
}

<!-- HIERARCHIA NAVIGÁCIÓS SÁV (ÚJ) -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-light p-3 rounded shadow-sm">
        <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">
            <i class="bi bi-briefcase-fill text-dark"></i> @Model.Company.Name (Cég / Telephely)
        </li>
    </ol>
</nav>

<!-- Címsor és gombok -->
<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-buildings-fill text-dark me-2"></i>@Model.Company.Name adatai</h2>
        <p class="text-muted mb-0 small">A telephelyhez tartozó infrastruktúra és összesített készletadatok.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm me-2">
            <i class="bi bi-arrow-left"></i> Vissza
        </a>
        <!-- Gyorsgomb új épület felviteléhez (Átadva a CompanyId az okos alapértelmezéshez!) -->
        <a asp-controller="Buildings" asp-action="Create" asp-route-companyId="@Model.Company.Id" class="btn btn-dark shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Új épület
        </a>
    </div>
</div>

<!-- Összesített statisztikai kártyák (100%-ban MEGTARTVA) -->
<partial name="_AggregateCards" model='new RaktarKeszlet.ViewModels.AggregateCardsViewModel {
    FirstCardTitle = "Nyilvántartott Épületek",
    FirstCardIcon = "bi-building",
    FirstCardCount = Model.TotalBuildingsCount,
    TotalProductsCount = Model.TotalProductsCount,
    TotalProductsValue = Model.TotalProductsValue,
    CompanyId = Model.Company.Id
}' />

<h4 class="mb-4 mt-5 text-secondary fw-bold"><i class="bi bi-buildings"></i> A telephelyhez tartozó épületek</h4>

<!-- MODERN KÁRTYÁS ELRENDEZÉS (Javítva: Funkcióvesztés nélkül, a Model.PagedBuildings-bõl olvasva) -->
@if (Model.PagedBuildings != null && Model.PagedBuildings.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        @foreach (var item in Model.PagedBuildings)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover bg-white">
                    <!-- KÁRTYA FEJLÉC -->
                    <div class="card-header bg-info text-white py-3">
                        <h6 class="card-title mb-0 fw-bold text-truncate" title="@item.Name">
                            <i class="bi bi-building me-2"></i>@item.Name
                        </h6>
                    </div>

                    <!-- KÁRTYA TEST -->
                    <div class="card-body text-center py-4">
                        <i class="bi bi-building-fill text-info opacity-75" style="font-size: 3rem;"></i>
                        <p class="card-text text-secondary small mt-3 mb-0">
                            Lépj be az épületbe a benne található helyiségek kezeléséhez.
                        </p>
                    </div>

                    <!-- MÛVELETI GOMBOK (Lefúrás + Gyors Termékfelvitel) -->
                    <div class="card-footer bg-light border-top-0 d-flex justify-content-between align-items-center py-3">
                        <!-- BELÉPÉS GOMB (Lefúrás a következõ szintre) -->
                        <a asp-controller="Buildings" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info fw-bold" title="Belépés az épületbe">
                            <i class="bi bi-arrow-right-circle"></i> Belépés
                        </a>

                        <!-- GYORS TERMÉK HOZZÁADÁSA (Cég és Épület adatok automatikus átadásával!) -->
                        <a asp-controller="Products" 
                           asp-action="Create" 
                           asp-route-companyId="@Model.Company.Id"
                           asp-route-buildingId="@item.Id"
                           class="btn btn-sm btn-success fw-bold"
                           title="Termék hozzáadása ebbe az épületbe">
                            <i class="bi bi-plus-circle"></i> + Termék
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info shadow-sm d-flex align-items-center py-4">
        <i class="bi bi-info-circle-fill fs-3 me-3 text-info"></i>
        <div>
            <strong class="fs-5">Nincsenek épületek!</strong><br />
            Ezen a telephelyen jelenleg még nincs egyetlen épület sem rögzítve.
        </div>
    </div>
}

<!-- LAPOZÓ VEZÉRLÕ (100%-ban MEGTARTVA) -->
<div class="mt-4">
    <partial name="_Pagination" model="(Model.CurrentPage, Model.TotalPages)" />
</div>