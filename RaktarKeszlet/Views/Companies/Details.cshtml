@model RaktarKeszlet.ViewModels.CompanyDetailsViewModel

@{
    ViewData["Title"] = "Telephely részletei";
}

<!-- Címsor és gombok -->
<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="fw-bold"><i class="bi bi-buildings me-2"></i>@Model.Company.Name adatai</h2>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm me-2">
            <i class="bi bi-arrow-left"></i> Vissza
        </a>
        <!-- Gyorsgomb új épület felviteléhez -->
        <a asp-controller="Buildings" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Új épület
        </a>
    </div>
</div>
<hr />

<!-- A korábbi 3 kártyát tartalmazó HTML kód HELYETT: -->
<partial name="_AggregateCards" model='new RaktarKeszlet.ViewModels.AggregateCardsViewModel {
    FirstCardTitle = "Nyilvántartott Épületek",
    FirstCardIcon = "bi-building",
    FirstCardCount = Model.TotalBuildingsCount,
    TotalProductsCount = Model.TotalProductsCount,
    TotalProductsValue = Model.TotalProductsValue,
    CompanyId = Model.Company.Id
}' />

<h4 class="mb-3 text-secondary"><i class="bi bi-buildings"></i> A telephelyhez tartozó épületek</h4>

<!-- AZ ÚJ KÁRTYÁS ELRENDEZÉS (A táblázat helyett, a Model.PagedBuildings-bõl olvasva) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
    @if (Model.PagedBuildings != null && Model.PagedBuildings.Any())
    {
        @foreach (var item in Model.PagedBuildings)
        {
            <div class="col">
                <!-- A kártya az Épület Részletek (Details) oldalára visz -->
                <a asp-controller="Buildings" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">

                    <div class="card h-100 shadow-sm border border-light-subtle product-card bg-white text-center">
                        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-2">
                            <i class="bi bi-building text-info" style="font-size: 3.5rem;"></i>
                        </div>

                        <div class="card-body d-flex flex-column pb-4">
                            <h5 class="card-title fw-bold mb-3">@item.Name</h5>

                            <div class="mt-auto">
                                <span class="badge bg-info text-dark px-3 py-2 rounded-pill">Épület</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info shadow-sm d-flex align-items-center">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <strong>Nincsenek épületek!</strong><br />
                    Ezen a telephelyen jelenleg még nincs egyetlen épület sem rögzítve.
                </div>
            </div>
        </div>
    }
</div>

<!-- A TE EREDETI LAPOZÓD (Megtartva!) -->
<partial name="_Pagination" model="(Model.CurrentPage, Model.TotalPages)" />